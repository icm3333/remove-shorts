{
  "manifest_version": 3,
  "name": "ShortsRemover",
  "version": "1.0",
  "description": "Removes Shorts from YouTube.",
  "permissions":[
    "storage"
  ],
  "action": {
    "default_popup": "src/pop.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["dist/content.js"]
    }
  ]
}